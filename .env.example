# ─────────────────────────────────────────────────────────────────────────────
# MZAZI TECH — link site
# Public, login-free WhatsApp device linking.
#
# ONLY DATABASE_URL IS REQUIRED. Everything below it has a working default and
# exists to let you override behaviour — set nothing else and the site runs.
#
#   Deploy with DATABASE_URL and that is the whole setup. On the first request
#   the app checks for its tables and creates any that are missing, so there is
#   no bootstrap step to remember. The schema is purely additive: it can never
#   drop a table or a row.
# ─────────────────────────────────────────────────────────────────────────────

# The one variable you must set.
# Shared Neon PostgreSQL connection string. MUST point at the same database the
# quartz bot and web/admin panels use, because this app talks to the bot
# exclusively through the device_requests and bot_sessions tables.
# Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Everything below is optional ─────────────────────────────────────────────

# Base URL used for metadata and link previews. Leave it unset on Vercel — it is
# derived from VERCEL_PROJECT_PRODUCTION_URL (or VERCEL_URL for previews) — and
# falls back to localhost elsewhere. Set it only to force a custom domain.
# NEXT_PUBLIC_BASE_URL="https://link.mzazi.shop"

# Set to "off" to stop the app creating missing tables on first use, and manage
# the schema yourself with `npm run db:init` or /api/init-db instead. Only worth
# doing if your database user has no DDL rights, or if you want migrations to be
# a deliberate, separate act. Leave it unset.
# AUTO_MIGRATE="off"

# Postgres NOTIFY channel this site signals when a request is queued, so the bot
# can pick it up in milliseconds instead of waiting for its next poll. Must match
# NOTIFY_CHANNEL on the bot. Leave it unset unless you changed it there too.
# NOTIFY_CHANNEL="mzazi_device_requests"

# ── Abuse controls ───────────────────────────────────────────────────────────
# This site has no login, so the only thing standing between a stranger and
# your WhatsApp sessions is throttling. Tune these before going public.
#
# Max link requests accepted per IP address inside the window.
RATE_LIMIT_IP_MAX="5"
# Window length in minutes for the per-IP limit.
RATE_LIMIT_IP_WINDOW_MIN="15"
# Max link requests accepted per phone number inside the window. Protects a
# single number from being hammered and keeps the queue fair.
RATE_LIMIT_PHONE_MAX="3"
# Window length in minutes for the per-phone limit.
RATE_LIMIT_PHONE_WINDOW_MIN="60"

# How long the page tells the user their pairing code is good for. Screen
# guidance only — nothing server-side expires a request, because the code's real
# lifetime is WhatsApp's to decide and the bot owns the request.
CODE_TTL_MINUTES="3"

# ── Removal (password) throttling ────────────────────────────────────────────
# A separate budget from the request limits above. Those cap queue flooding;
# these cap password guessing, which is a different attack.
#
# Guesses allowed from one IP address across ALL numbers inside the window. This
# is what catches someone spraying a few guesses at many numbers — the
# per-number lockout below would never notice that pattern.
VERIFY_IP_MAX="12"
VERIFY_IP_WINDOW_MIN="15"

# Wrong guesses against ONE number before it is temporarily locked. This is the
# backstop that matters most: scrypt makes offline cracking hopeless, but it does
# nothing against someone guessing online one request at a time.
VERIFY_LOCKOUT_AFTER="5"
VERIFY_LOCKOUT_MINUTES="15"

# How long the verification audit table (password_attempts) is kept. It is
# pruned opportunistically on roughly 1 in 25 verifications, since the site is
# serverless and has no scheduler of its own.
VERIFY_LOG_RETENTION_DAYS="7"

# ── Primary password for numbers paired without one ──────────────────────────
# Numbers paired before this site existed were never asked for a password. These
# values are accepted for them, so those sessions can still be removed instead of
# being stuck forever.
#
# UNDERSTAND THE TRADE BEFORE RELYING ON THIS. It is a public master key: anyone
# who knows it can delete any session that has no password of its own. It is not
# a secret in any real sense once it sits in a repository and is used by a page
# with no login.
#
# The way out is to convert the legacy numbers: relink a number, set a real
# password, and it stops accepting these. `SELECT phone FROM bot_sessions_active
# WHERE has_password = false` lists exactly which ones still need it. Once that
# query returns nothing, set this to an empty string to switch the fallback off
# entirely - that is the correct end state.
LEGACY_DEFAULT_PASSWORDS="1234,0000"

# ── Schema initialisation endpoint (optional) ────────────────────────────────
# /api/init-db applies lib/schema.sql to DATABASE_URL.
#
# You do NOT need this to get started. While the schema is missing, that endpoint
# is reachable without a key — so with only DATABASE_URL set, just open it once:
#
#   https://<deployment>/api/init-db
#
# Set a key only if you want to RE-RUN the schema later (an upgrade, or a repair)
# without a local checkout. Once the tables exist, the endpoint refuses
# unauthenticated calls, so this key is the only way back in:
#
#   curl -X POST -H "x-init-key: <value>" https://<deployment>/api/init-db
#
# Use a long random value. The schema is purely additive — it never drops a table
# or a row — so even a leaked key cannot destroy data.
# INIT_DB_KEY=""

# ── Optional ─────────────────────────────────────────────────────────────────
# Sent as `x-link-key` on internal maintenance callers only. Leave unset unless
# you front the app with an additional gate.
# LINK_INTERNAL_KEY=""

# Salt for hashing caller IPs before storage, so a raw IP is never written to the
# shared database. Leave it unset: a stable salt is derived from DATABASE_URL,
# which keeps the per-IP throttle correct across serverless instances (each
# instance needed the same salt to see the others' rows). Set it only to rotate.
# IP_HASH_SALT=""
