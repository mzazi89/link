# ─────────────────────────────────────────────────────────────────────────────
# MZAZI TECH — link site
# Public, login-free WhatsApp device linking.
# ─────────────────────────────────────────────────────────────────────────────

# Shared Neon PostgreSQL connection string.
# MUST be the same database the quartz bot and web/admin panels use, because
# this app talks to the bot exclusively through the link_requests table.
# Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Public base URL of this deployment — used for link previews and the manifest.
NEXT_PUBLIC_BASE_URL="https://link.mzazi.shop"

# ── Abuse controls ───────────────────────────────────────────────────────────
# This site has no login, so the only thing standing between a stranger and
# your WhatsApp sessions is throttling. Tune these before going public.
#
# Max link requests accepted per IP address inside the window.
RATE_LIMIT_IP_MAX="5"
# Window length in minutes for the per-IP limit.
RATE_LIMIT_IP_WINDOW_MIN="15"
# Max link requests accepted per phone number inside the window. Protects a
# single number from being hammered and keeps the queue fair.
RATE_LIMIT_PHONE_MAX="3"
# Window length in minutes for the per-phone limit.
RATE_LIMIT_PHONE_WINDOW_MIN="60"

# How long a queued request stays alive waiting for the bot to pick it up
# before it is reported to the user as expired. Keep this comfortably longer
# than the bot's poll interval.
LINK_TTL_MINUTES="10"

# ── Optional ─────────────────────────────────────────────────────────────────
# Sent as `x-link-key` on internal maintenance callers only. Leave unset unless
# you front the app with an additional gate.
# LINK_INTERNAL_KEY=""

# Salt for hashing caller IPs before storage. Set this to any long random
# string so raw IPs are never written to the shared database. If unset, IPs are
# hashed with a per-process random salt (fine for dedupe inside one instance,
# useless for forensics across restarts).
IP_HASH_SALT=""
